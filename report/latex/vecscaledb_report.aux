\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces VecScaleDB shared-storage architecture. Coordinators maintain metadata and fan out search queries. The writer persists mutations and creates immutable segments. Readers load segments on demand for search execution.}}{4}{figure.caption.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}Storage Layout}{4}{subsection.2.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Request Flows}{5}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Insert and Delete Flow}{5}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Write path. WAL append happens before the mutation becomes visible, ensuring durability. Threshold-triggered flushes convert MemTable contents into immutable FAISS-backed segments. Deletes are WAL records that are immediately reflected in search via tombstone filtering.}}{5}{figure.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Search Flow}{5}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Search path. Queries execute against a consistent snapshot. Readers search their local FAISS segment caches and return partial top-k results that the coordinator merges into the final answer.}}{5}{figure.caption.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}WAL Recovery Flow}{6}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces WAL recovery. The engine replays records newer than the latest flushed segment. Corrupt or incomplete trailing records are ignored so partial writes do not poison recovery.}}{6}{figure.caption.8}\protected@file@percent }
